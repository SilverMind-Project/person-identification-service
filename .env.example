# Person Identification Service - Environment Variables
# Copy to .env and fill in your values.

COMPOSE_PROJECT_NAME=nanai

# ─── PostgreSQL Database (shared instance — see ../db/docker-compose.db.yml) ──
DATABASE_URL=postgresql://pid_user:change-me-pid-password@postgres:5432/person_identification

# ─── MinIO / S3 Object Storage ────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=cognitive-companion

# ─── GPU ─────────────────────────────────────────────────────────
CUDA_DEVICE_ID=0
